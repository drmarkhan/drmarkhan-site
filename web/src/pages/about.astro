---
import Base from '../layouts/Base.astro'
import {getSiteSettings} from '../lib/queries'

const site = await getSiteSettings()
const p = site.pages?.about || {}
const about = site.about || {}
---

<Base title={p.title} description={p.description}>
  <main id="about" class="view active">
    <section class="page-head about-head">
      <div class="wrap narrow">
        <p class="overline">{p.overline}</p>
        <h1 set:html={p.title} />
        <p set:html={p.description} />
      </div>
    </section>
    <section class="content-section">
      <div class="wrap about-layout">
        <article class="about-story">
          {
            (about.paragraphs || []).map((para: string, i: number) => (
              <p class:list={[{large: i === 0}]}>{para}</p>
            ))
          }
        </article>
        <aside class="about-facts">
          {
            (about.facts || []).map((f: any) => (
              <div>
                <span>{f.label}</span>
                <div class="fact-rich">
                  <b>{f.value}</b>
                </div>
              </div>
            ))
          }
        </aside>
      </div>
    </section>
  </main>
</Base>
