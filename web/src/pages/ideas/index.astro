---
import Base from '../../layouts/Base.astro'
import {getSiteSettings, getConcepts} from '../../lib/queries'
import {portableTextToHtml} from '../../lib/portableText'

const site = await getSiteSettings()
const concepts = await getConcepts()
const p = site.pages?.framework || {}
---

<Base title={p.title} description={p.description}>
  <main id="framework" class="view active">
    <section class="page-head">
      <div class="wrap narrow">
        <p class="overline">{p.overline}</p>
        <h1 set:html={p.title} />
        <p set:html={p.description} />
      </div>
    </section>
    <section class="content-section">
      <div class="wrap">
        <div id="frameworkList" class="idea-list">
          {
            concepts.map((c: any) => (
              <article class="idea-row">
                <div class="num">{c.code}</div>
                <div>
                  <h2>{c.title}</h2>
                  <div class="rich-snippet" set:html={portableTextToHtml(c.description)} />
                </div>
                <div class="stage">{c.stage}</div>
              </article>
            ))
          }
        </div>
      </div>
    </section>
  </main>
</Base>
