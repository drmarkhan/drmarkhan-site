---
import '../styles/global.css'
import {getSiteSettings} from '../lib/queries'

interface Props {
  title?: string
  description?: string
}

const {title, description} = Astro.props as Props
const site = await getSiteSettings()
const path = Astro.url.pathname

// <title>/meta content must be plain text — strip any inline HTML (e.g. <br>)
// that page-copy fields carry for visual rendering elsewhere on the page.
const stripHtml = (value?: string) => (value || '').replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim()
const pageTitle = stripHtml(title) || site.meta?.title
const pageDescription = stripHtml(description) || site.meta?.description

const navItems = [
  {href: '/', key: 'home'},
  {href: '/writing', key: 'journal'},
  {href: '/ideas', key: 'framework'},
  {href: '/work', key: 'projects'},
  {href: '/research', key: 'research'},
  {href: '/about', key: 'about'},
  {href: '/opic/', key: 'study'},
]

function isActive(href: string) {
  if (href === '/') return path === '/'
  return path.startsWith(href)
}
---

<!doctype html>
<html lang={site.meta?.language || 'ko'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
    <meta name="theme-color" content="#f7f5f0" />
    <meta name="description" content={pageDescription} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <div class="reading-progress" id="progress"></div>
    <header class="site-header">
      <div class="wrap nav-wrap">
        <a class="wordmark" href="/">
          <strong>{site.brand?.name}</strong>
          <span>{site.brand?.subject}</span>
        </a>
        <nav class="desktop-links">
          {
            navItems.map((item) => (
              <a class:list={[{active: isActive(item.href)}]} href={item.href}>
                <span>{item.key === 'study' ? 'Study' : site.nav?.[item.key]}</span>
              </a>
            ))
          }
        </nav>
        <div class="nav-end">
          <button class="menu" id="menuToggle"><span>{site.nav?.menu}</span></button>
        </div>
      </div>
    </header>

    <div id="drawer" class="drawer">
      <div class="drawer-panel">
        <button class="drawer-x" id="drawerClose">{site.nav?.close}</button>
        {navItems.map((item) => <a href={item.href}>{item.key === 'study' ? 'Study' : site.nav?.[item.key]}</a>)}
      </div>
    </div>

    <slot />

    <footer>
      <div class="wrap footer-grid">
        <div>
          <strong>{site.brand?.name}</strong>
          <span>{site.brand?.subject}</span>
        </div>
        <p>
          <span set:html={site.footer?.line1} />
          <br />
          <span set:html={site.footer?.line2} />
        </p>
        <div>
          <span>{site.footer?.copyright}</span>
        </div>
      </div>
    </footer>

    <script>
      const progress = document.getElementById('progress')
      window.addEventListener('scroll', () => {
        const h = document.documentElement
        if (progress) progress.style.width = `${(h.scrollTop / (h.scrollHeight - h.clientHeight)) * 100}%`
      })
      const drawer = document.getElementById('drawer')
      document.getElementById('menuToggle')?.addEventListener('click', () => {
        drawer?.classList.add('open')
        document.body.classList.add('locked')
      })
      document.getElementById('drawerClose')?.addEventListener('click', () => {
        drawer?.classList.remove('open')
        document.body.classList.remove('locked')
      })
      drawer?.addEventListener('click', (e) => {
        if (e.target === drawer) {
          drawer.classList.remove('open')
          document.body.classList.remove('locked')
        }
      })
    </script>
  </body>
</html>
